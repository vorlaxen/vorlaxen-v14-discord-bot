{
  "name": "vorlaxen-v14-discord-bot",
  "version": "1.0.0",
  "description": "Vorlaxen Discord V14 Bot",
  "main": "dist/app.js",
  "proxy": "http://localhost:5000",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/app.ts",
    "dev:nodemon": "nodemon",
    "worker:dev": "ts-node src/infrastructure/queues/queue.worker.ts",
    "build": "tsc --skipLibCheck || true",
    "start": "cross-env NODE_ENV=production node -r module-alias/register dist/app.js"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "dependencies": {
    "bullmq": "^5.1.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "module-alias": "^2.2.3",
    "redis": "^4.6.13",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "@types/winston": "^2.4.4",
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0"
}